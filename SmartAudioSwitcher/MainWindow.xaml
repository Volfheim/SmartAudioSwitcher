<Window x:Class="SmartAudioSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="Smart Audio Switcher"
        Height="720"
        Width="1080"
        MinHeight="720"
        MinWidth="980"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#2B2D42"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#6C63FF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5A52D5"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#3A3C55"/>
        <SolidColorBrush x:Key="DangerColor" Color="#ED1C24"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"/>

                            <ContentPresenter Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Margin="5,3,3,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Margin="5,3,3,3"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <ToggleButton Name="ToggleButton"
                                          Grid.Column="1"
                                          Panel.ZIndex="2"
                                          ClickMode="Press"
                                          Focusable="false"
                                          Width="30"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Template="{DynamicResource ComboBoxToggleButtonTemplate}"/>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource ControlBackground}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource AccentColor}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Grid>
                <Border CornerRadius="0,4,4,0"
                        Background="#4A4C66"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1,0,0,0"/>
                <Path Fill="White"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 6 6 L 12 0 Z"/>
            </Grid>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlBackground}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowBackground}" CornerRadius="10" BorderThickness="1" BorderBrush="#333333">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <TextBlock Text="Smart Audio Switcher" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Bold" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Button Content="_" Width="30" Height="30" Click="BtnMinimize_Click" Style="{StaticResource IconButtonStyle}" ToolTip="Свернуть"/>
                    <Button Content="X" Width="30" Height="30" Click="BtnClose_Click" Style="{StaticResource IconButtonStyle}" Foreground="{StaticResource DangerColor}" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="15,10,15,10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Управляемые аудиоустройства" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="DevicesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#222436" BorderBrush="#363954" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Width="140" 
                                                                 Background="Transparent" 
                                                                 Foreground="White" 
                                                                 FontWeight="SemiBold"
                                                                 BorderThickness="0,0,0,1" 
                                                                 BorderBrush="#33FFFFFF"
                                                                 Margin="0,0,10,0" 
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="Изменить имя устройства"/>
                                                        <Button Content="{Binding HotkeyDisplay}" 
                                                                Tag="{Binding Id}" 
                                                                Click="BtnHotkeyDevice_Click" 
                                                                Style="{StaticResource ModernButton}" 
                                                                FontSize="10" 
                                                                Padding="6,3" 
                                                                VerticalAlignment="Center"
                                                                ToolTip="Назначить горячую клавишу"/>
                                                    </StackPanel>

                                                    <Button Grid.Row="0" Grid.Column="1" 
                                                            Width="20" Height="20" 
                                                            Style="{StaticResource IconButtonStyle}" 
                                                            Foreground="{StaticResource DangerColor}" 
                                                            Tag="{Binding Id}" 
                                                            Click="BtnRemoveDevice_Click" 
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Удалить устройство">
                                                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" 
                                                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                                              StrokeThickness="1.8" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center" 
                                                              Width="8" Height="8"/>
                                                    </Button>

                                                    <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                                                              SelectedValuePath="Id" 
                                                              SelectedValue="{Binding DeviceId, Mode=OneWay}" 
                                                              DisplayMemberPath="Name" 
                                                              ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=AvailableDevices}" 
                                                              SelectionChanged="CmbDevice_SelectionChanged"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Row="2" Content="+ Добавить устройство" Style="{StaticResource ModernButton}" Click="BtnAddDevice_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>


                    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="15" MaxHeight="300">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>


                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Микрофон:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyMic" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyMic_Click"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость +:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyVolUp" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyVolUp_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Громкость -:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyVolDown" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyVolDown_Click"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Пред. трек:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyPrevTrack" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyPrevTrack_Click"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="След. трек:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyNextTrack" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyNextTrack_Click"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Play / Pause:" VerticalAlignment="Center" Width="80"/>
                                    <Button x:Name="BtnHotkeyPlayPause" Content="Назначить" Grid.Column="1" Style="{StaticResource ModernButton}" Click="BtnHotkeyPlayPause_Click"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>



                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сценарии (Автосмена)" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <CheckBox x:Name="ChkAutoSwitch"
                                              Content="Включено"
                                              Foreground="White"
                                              Checked="ChkAutoSwitch_Changed"
                                              Unchecked="ChkAutoSwitch_Changed"/>
                                    <CheckBox x:Name="ChkFallback"
                                              Content="Автовозврат на колонки"
                                              IsChecked="True"
                                              Foreground="{StaticResource TextSecondary}"
                                              FontSize="11"
                                              Margin="0,2,0,0"
                                              ToolTip="Если активное окно не найдено в сценариях, звук вернется на колонки."
                                              Checked="ChkFallback_Changed"
                                              Unchecked="ChkFallback_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="ScenarioInputGrid"
                                  Grid.Row="1"
                                  Margin="0,0,0,10"
                                  SizeChanged="ScenarioInputGrid_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="CmbProcessPicker"
                                          Grid.Column="0"
                                          Margin="0,0,5,0"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          Foreground="White"
                                          DropDownOpened="CmbProcessPicker_DropDownOpened"
                                          SelectionChanged="CmbProcessPicker_SelectionChanged"
                                          ToolTip="Выберите запущенную программу или введите process.exe">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="{Binding ProcessName, StringFormat=' ({0})'}"
                                                           VerticalAlignment="Center"
                                                           Foreground="Gray"
                                                           FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox x:Name="CmbTargetDevice"
                                          Grid.Column="1"
                                          Width="190"
                                          MinWidth="180"
                                          MaxWidth="560"
                                          Margin="0,0,5,0"
                                          DisplayMemberPath="Name"
                                          Foreground="White"
                                          SelectionChanged="CmbTargetDevice_SelectionChanged"/>
                                <Button x:Name="BtnAddScenario"
                                        Grid.Column="2"
                                        Content="+"
                                        Width="30"
                                        Style="{StaticResource ModernButton}"
                                        Click="BtnAddScenario_Click"
                                        ToolTip="Добавить или обновить сценарий"/>
                            </Grid>

                            <ListView x:Name="ListScenarios"
                                      Grid.Row="2"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="White">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Background="{TemplateBinding Background}" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.45*"/>
                                                <ColumnDefinition Width="1.15*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProcessName}"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,8,0"
                                                       Text="{Binding TargetDeviceName}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TargetDeviceName}"/>
                                            <Button Grid.Column="2"
                                                    Content="x"
                                                    Width="20"
                                                    Height="20"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{StaticResource DangerColor}"
                                                    Click="BtnRemoveScenario_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnSettings"
                                Content="Настройки"
                                Width="140"
                                Style="{StaticResource ModernButton}"
                                Click="BtnSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <tb:TaskbarIcon x:Name="TrayIcon"
                            ToolTipText="Smart Audio Switcher"
                            Visibility="Visible"
                            IconSource="pack://application:,,,/app.ico"
                            TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" Click="MenuItemOpen_Click"/>
                        <MenuItem Header="Настройки" Click="MenuItemSettings_Click"/>
                        <MenuItem Header="Проверить обновления" Click="MenuItemUpdate_Click"/>
                        <Separator Style="{StaticResource ContextMenuSeparator}"/>
                        <MenuItem Header="Выход" Click="MenuItemExit_Click" Foreground="#FF6B6B"/>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </Grid>
    </Border>
</Window>


