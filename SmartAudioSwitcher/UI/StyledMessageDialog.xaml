<Window x:Class="SmartAudioSwitcher.UI.StyledMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Audio Switcher"
        Width="420"
        Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Background="#1E1E2E" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <TextBlock x:Name="LblTitle"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           Foreground="White"/>
                <Button Content="X"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Margin="0,5,10,5"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#ED1C24"
                        Click="BtnClose_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,8,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SeverityMarker"
                        Width="14"
                        Height="14"
                        CornerRadius="7"
                        Margin="0,4,10,0"
                        Background="#6C63FF"/>
                <TextBlock x:Name="LblMessage"
                           Grid.Column="1"
                           FontFamily="Segoe UI"
                           Foreground="White"
                           TextWrapping="Wrap"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,15,20,20" HorizontalAlignment="Right">
                <Button x:Name="BtnOk" Width="120" Height="34" Content="ОК" Background="#6C63FF" Foreground="White" BorderThickness="0" Click="BtnOk_Click"/>
                <StackPanel x:Name="PnlQuestion" Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="BtnYes" Width="120" Height="34" Content="Да" Background="#6C63FF" Foreground="White" BorderThickness="0" Click="BtnYes_Click" Margin="0,0,10,0"/>
                    <Button x:Name="BtnNo" Width="120" Height="34" Content="Нет" Background="#3A3C55" Foreground="White" BorderThickness="0" Click="BtnNo_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
