<Window x:Class="SmartAudioSwitcher.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="430"
        Height="290"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="Transparent">
    <Border Background="#1E1E2E" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="Настройки"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           Foreground="White"/>
                <Button Content="X"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        Margin="0,5,10,5"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#ED1C24"
                        Click="BtnClose_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="20,8,20,0">
                <TextBlock Text="Общие"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,10"/>

                <CheckBox x:Name="ChkStartMinimized"
                          Content="Запускать свернутым в трей"
                          Foreground="White"
                          Margin="0,0,0,8"
                          Checked="OptionChanged"
                          Unchecked="OptionChanged"/>

                <CheckBox x:Name="ChkMinimizeToTrayOnClose"
                          Content="Сворачивать в трей при закрытии окна"
                          Foreground="White"
                          Margin="0,0,0,8"
                          Checked="OptionChanged"
                          Unchecked="OptionChanged"/>

                <CheckBox x:Name="ChkAutoStart"
                          Content="Запускать вместе с Windows"
                          Foreground="White"
                          Margin="0,0,0,6"
                          Checked="OptionChanged"
                          Unchecked="OptionChanged"/>

                <CheckBox x:Name="ChkShowNotifications"
                          Content="Показывать уведомления"
                          Foreground="White"
                          Margin="0,0,0,8"
                          Checked="OptionChanged"
                          Unchecked="OptionChanged"/>

                <CheckBox x:Name="ChkShowMicOverlay"
                          Content="Показывать значок микрофона (оверлей)"
                          Foreground="White"
                          Margin="0,0,0,6"
                          Checked="OptionChanged"
                          Unchecked="OptionChanged"/>

                <TextBlock Text="Изменения применяются и сохраняются автоматически."
                           TextWrapping="Wrap"
                           Foreground="#B0B0B0"
                           FontSize="12"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,20,20">
                <Button x:Name="BtnUpdateCheck"
                        Margin="0,0,10,0"
                        Width="160"
                        Height="34"
                        Content="Проверить обновления"
                        Background="#3A3C55"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BtnUpdateCheck_Click"/>
                <Button Width="120"
                        Height="34"
                        Content="Закрыть"
                        Background="#6C63FF"
                        Foreground="White"
                        BorderThickness="0"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

